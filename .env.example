# Copy to .env.local for `npm run dev`. On Vercel, set the same names
# in Project → Settings → Environment Variables (Production and Preview).
# Never commit real values. `.env*` is gitignored.

# HMAC for the __Host-op-cms session cookie. 16+ characters; 32 random bytes is better.
CMS_SESSION_SECRET=

# Prefer the Argon2id hash from `npm run cms:hash -- 'passphrase'`.
ADMIN_PASSWORD_HASH=
# Plaintext is accepted only as a local fallback. Do not set this in Production.
# ADMIN_PASSWORD=

# Neon/Supabase pooled URL. Required on Vercel — the serverless filesystem is not a database.
DATABASE_URL=

# Vercel Blob read/write token. Required before the media desk can store uploads.
BLOB_READ_WRITE_TOKEN=
